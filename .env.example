# GEMINI_API_KEY: Backend-only secret for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets; never expose to VITE_* client code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY (or GOOGLE_MAPS_API_KEY): Browser-restricted Google Maps Platform JS key.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# --- Backend-Only Official & Secondary Environmental / Disaster Data Credentials ---
# Official CPCB Real-Time CAAQMS Data via data.gov.in (resource 3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69)
DATA_GOV_IN_API_KEY="YOUR_DATA_GOV_IN_API_KEY"

# Secondary Ground-Station AQI Providers (optional backend keys; used with explicit attribution)
OPENAQ_API_KEY="YOUR_OPENAQ_API_KEY"
WAQI_API_TOKEN="YOUR_WAQI_API_TOKEN"
IQAIR_API_KEY="YOUR_IQAIR_API_KEY"

# Optional Authorized Official Disaster Endpoints (backend-only; requires agency authorization/whitelisting)
IMD_AUTHORIZED_API_URL="YOUR_AUTHORIZED_IMD_API_URL"
OSDMA_AUTHORIZED_FEED_URL="YOUR_AUTHORIZED_OSDMA_FEED_URL"
CWC_AUTHORIZED_FEED_URL="YOUR_AUTHORIZED_CWC_FEED_URL"

# Optional Comma-Separated HTTPS JSON/CAP Feed URLs for Additional External Feeds (backend-only)
CUSTOM_DISASTER_FEED_URLS=""
